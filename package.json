{
  "name": "peach-demo",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/peach-mitao/peach-demo.git"
  },
  "scripts": {
    "sync": "node scripts/sync_frontend.ts",
    "edit:sync": "node scripts/sync_copy_editor.ts",
    "edit:ui:sync": "node scripts/sync_editor_ui.ts",
    "assets:import": "node scripts/import_assets.ts",
    "assets:movies": "node scripts/prepare_public_movies.ts",
    "browser:build": "node scripts/build_browser.ts",
    "behavior:check": "node scripts/check_behavior.ts",
    "behavior:capture": "node scripts/capture_behavior.ts",
    "assets:build": "npm run browser:build && node scripts/prepare_showcase.ts && node scripts/build_public.ts",
    "media:plan": "node scripts/media_storage.ts plan",
    "media:local": "node scripts/media_storage.ts upload --local",
    "media:upload": "node scripts/media_storage.ts upload --remote",
    "media:verify": "node scripts/media_storage.ts verify --remote",
    "build": "npm run assets:build && cf build",
    "precheck": "npm run browser:build && cf workers types",
    "check": "tsc --noEmit && tsc -p tsconfig.browser.json && node scripts/check.ts",
    "check:deploy": "node scripts/check_deploy.ts",
    "pretest": "npm run browser:build",
    "test": "node --test tests/*.test.ts",
    "test:browser": "node scripts/check_browser.ts && node scripts/check_filters.ts && node scripts/check_edit.ts",
    "test:search": "node scripts/check_search_recommendations.ts",
    "test:folders": "node scripts/check_folders.ts",
    "test:routes": "node scripts/check_routes.ts",
    "verify:region": "node scripts/check_region.ts",
    "test:tags": "node scripts/check_tag_management.ts",
    "test:stream": "node scripts/check_stream.ts",
    "test:public-movies": "node scripts/check_public_movies_browser.ts",
    "test:replay": "node scripts/check_replay.ts",
    "dev": "cf dev",
    "predev": "npm run assets:build",
    "predeploy": "node scripts/check_package.ts --assets && npm run build && npm run behavior:check",
    "deploy": "cf deploy --prebuilt"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261023.1",
    "@noble/hashes": "2.4.0",
    "@types/node": "24.19.2",
    "acorn": "8.19.0",
    "cf": "1.0.0-beta.18",
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "wrangler": "4.151.2"
  }
}
