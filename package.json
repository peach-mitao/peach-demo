{
  "name": "peach-demo",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/peach-mitao/peach-demo.git"
  },
  "scripts": {
    "sync": "node scripts/sync_frontend.mjs",
    "assets:import": "node scripts/import_assets.mjs",
    "build": "node scripts/build_static.mjs",
    "check": "tsc --noEmit && node scripts/check.mjs",
    "check:deploy": "wrangler deploy --dry-run --outdir .cache/worker",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/check_browser.mjs && node scripts/check_filters.mjs",
    "test:search": "node scripts/check_search_recommendations.mjs",
    "test:stream": "node scripts/check_stream.mjs",
    "dev": "wrangler dev --ip 127.0.0.1 --port 8791",
    "predev": "npm run build",
    "predeploy": "node scripts/check_package.mjs --assets && npm run build",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@noble/hashes": "2.4.0",
    "acorn": "8.19.0",
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "wrangler": "4.151.2",
    "typescript": "7.0.2",
    "@types/node": "24.19.2"
  }
}
