{
  "name": "peach-demo",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/peach-mitao/peach-demo.git"
  },
  "scripts": {
    "sync": "node scripts/sync_frontend.mjs",
    "assets:import": "node scripts/import_assets.mjs",
    "assets:build": "node scripts/build_static.mjs",
    "media:plan": "node scripts/media_storage.ts plan",
    "media:local": "node scripts/media_storage.ts upload --local",
    "media:upload": "node scripts/media_storage.ts upload --remote",
    "media:verify": "node scripts/media_storage.ts verify --remote",
    "build": "npm run assets:build && cf build",
    "precheck": "cf workers types",
    "check": "tsc --noEmit && node scripts/check.mjs",
    "check:deploy": "cf deploy --dry-run",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/check_browser.mjs && node scripts/check_filters.mjs",
    "test:search": "node scripts/check_search_recommendations.mjs",
    "test:stream": "node scripts/check_stream.mjs",
    "dev": "cf dev",
    "predev": "npm run assets:build",
    "predeploy": "node scripts/check_package.mjs --assets && npm run build && npm run media:verify",
    "deploy": "cf deploy --prebuilt"
  },
  "devDependencies": {
    "@noble/hashes": "2.4.0",
    "@types/node": "24.19.2",
    "acorn": "8.19.0",
    "cf": "1.0.0-beta.19",
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "wrangler": "4.151.2"
  }
}
